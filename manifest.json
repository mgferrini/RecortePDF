{
  "manifest_version": 3,
  "name": "Corte 10×15",
  "version": "1.0.0",
  "description": "Recorta el PDF de la etiqueta que tenés abierto a 100 × 150 mm, sin achicar el código de barras.",
  "action": {
    "default_title": "Recortar esta etiqueta a 10×15",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/16.png",
      "32": "icons/32.png",
      "48": "icons/48.png"
    }
  },
  "icons": {
    "16": "icons/16.png",
    "48": "icons/48.png",
    "128": "icons/128.png"
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "permissions": ["storage", "downloads", "contextMenus", "activeTab"],
  "host_permissions": ["<all_urls>", "file:///*"],
  "commands": {
    "crop-now": {
      "suggested_key": {
        "default": "Ctrl+Shift+E",
        "mac": "Command+Shift+E"
      },
      "description": "Recortar el PDF abierto a 10×15"
    }
  }
}
